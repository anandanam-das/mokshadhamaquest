PORT=4000

# Postgres connection
PGHOST=quest-postgres
PGPORT=5432
POSTGRES_DB=moksha_quest
POSTGRES_USER=moksha_quest
POSTGRES_PASSWORD=replace-with-a-long-random-string

# Must match the frontend's /api/quest-token minting secret exactly —
# this is what requireAuth verifies incoming Bearer tokens against.
QUEST_API_SECRET=replace-with-a-long-random-string

# Comma-separated origins allowed to call this API (CORS)
ALLOWED_ORIGINS=https://www.moksha-education.com

# Telegram numeric ids with admin access to /api/admin/*
ADMIN_TELEGRAM_IDS=8254725055

# Base URL of the public certificate-verification page (QR code target)
VERIFY_BASE_URL=https://www.moksha-education.com/quest/verify.html

# --- Email (Resend) ---
# From https://resend.com/api-keys — needs a verified sending domain in
# the Resend dashboard (moksha-education.com) before it can send to real
# inboxes; resend.dev test addresses work without domain verification.
RESEND_API_KEY=re_replace_with_real_key
EMAIL_FROM=MOKSHA Quest <noreply@moksha-education.com>
# Base URL of the public "confirm email" page (link inside the email)
EMAIL_VERIFY_BASE_URL=https://www.moksha-education.com/quest/verify-email.html

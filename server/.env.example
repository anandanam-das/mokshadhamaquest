PORT=3001

# From @BotFather when you create the bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The private channel/chat users must be subscribed to.
# Use the numeric id (looks like -1001234567890) — get it by adding
# the bot to the chat as admin and calling getUpdates, or by
# forwarding a message from the chat to @userinfobot / @RawDataBot.
# A public @username also works if the chat is not private.
TELEGRAM_CHANNEL_ID=-1001234567890

# Any long random string, used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# Origin the frontend is served from (for CORS + cookies)
ALLOWED_ORIGIN=http://localhost:8765
